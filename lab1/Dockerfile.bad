# Плохой, но рабочий образ dataset-profiler. Антипаттерны разобраны в README.md.
FROM python:latest

RUN apt-get update
RUN DEBIAN_FRONTEND=noninteractive apt-get upgrade -y
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y vim curl build-essential

ENV PROFILER_TOKEN=lab1-do-not-use-this-token
ENV DATA_DIR=/data

WORKDIR /app

COPY . /app

RUN pip install fastapi uvicorn pandas
RUN chmod -R 777 /app

EXPOSE 8000

CMD python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
